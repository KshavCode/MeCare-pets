rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'username',
          'activeSpeciesId',
          'activePetName',
          'unlockedSpecies',
          'petXp',
          'petHealth',
          'petHappiness',
          'petEnergy',
          'gold',
          'streakDays',
          'cheatCount',
          'totalTasksCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'activeSpeciesId',
          'activePetName',
          'unlockedSpecies',
          'petXp',
          'petHealth',
          'petHappiness',
          'petEnergy',
          'gold',
          'streakDays',
          'cheatCount',
          'totalTasksCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 32 && data.username.matches('^[a-zA-Z0-9_\\-]+$')
        && data.activeSpeciesId is string && data.activeSpeciesId.size() >= 3 && data.activeSpeciesId.size() <= 40 && data.activeSpeciesId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.activePetName is string && data.activePetName.size() >= 1 && data.activePetName.size() <= 28
        && data.unlockedSpecies is list && data.unlockedSpecies.size() >= 1 && data.unlockedSpecies.size() <= 50
        && data.unlockedSpecies[0] is string && data.unlockedSpecies[0].size() >= 3 && data.unlockedSpecies[0].size() <= 40
        && data.petXp is number && data.petXp >= 0 && data.petXp <= 1000000
        && data.petHealth is number && data.petHealth >= 0 && data.petHealth <= 100
        && data.petHappiness is number && data.petHappiness >= 0 && data.petHappiness <= 100
        && data.petEnergy is number && data.petEnergy >= 0 && data.petEnergy <= 100
        && data.gold is number && data.gold >= 0 && data.gold <= 1000000
        && data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000
        && data.cheatCount is number && data.cheatCount >= 0 && data.cheatCount <= 100000
        && data.totalTasksCompleted is number && data.totalTasksCompleted >= 0 && data.totalTasksCompleted <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskItem(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'category',
          'difficulty',
          'status',
          'minDurationSeconds',
          'xpReward',
          'goldReward',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'category',
          'difficulty',
          'status',
          'minDurationSeconds',
          'xpReward',
          'goldReward',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId == request.auth.uid
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.category is string && data.category.size() >= 3 && data.category.size() <= 24
        && data.category in ['vitality', 'intellect', 'strength', 'discipline']
        && data.difficulty is string && data.difficulty.size() >= 4 && data.difficulty.size() <= 16
        && data.difficulty in ['quick', 'standard', 'deep', 'epic']
        && data.status is string && data.status.size() >= 7 && data.status.size() <= 16
        && data.status in ['pending', 'completed', 'penalized']
        && data.minDurationSeconds is number && data.minDurationSeconds >= 5 && data.minDurationSeconds <= 86400
        && data.xpReward is number && data.xpReward >= 1 && data.xpReward <= 5000
        && data.goldReward is number && data.goldReward >= 1 && data.goldReward <= 5000
        && data.createdAtMs is number && data.createdAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. User Profile Rules (/users/{userId})
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Rename active companion
          incoming().diff(existing()).affectedKeys().hasOnly(['activePetName', 'updatedAt']) ||
          // Action 2: Switch or unlock companion species
          incoming().diff(existing()).affectedKeys().hasOnly(['activeSpeciesId', 'activePetName', 'unlockedSpecies', 'gold', 'updatedAt']) ||
          // Action 3: Progress companion stats, XP, gold, streak, or anti-cheat penalty
          incoming().diff(existing()).affectedKeys().hasOnly([
            'petXp',
            'petHealth',
            'petHappiness',
            'petEnergy',
            'gold',
            'streakDays',
            'cheatCount',
            'totalTasksCompleted',
            'updatedAt'
          ]) ||
          // Action 4: Full profile sync
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username',
            'activeSpeciesId',
            'activePetName',
            'unlockedSpecies',
            'petXp',
            'petHealth',
            'petHappiness',
            'petEnergy',
            'gold',
            'streakDays',
            'cheatCount',
            'totalTasksCompleted',
            'updatedAt'
          ])
        );

      allow delete: if isVerified() && isValidId(userId) && request.auth.uid == userId;

      // 5. User Tasks Subcollection (/users/{userId}/tasks/{taskId})
      match /tasks/{taskId} {
        allow get: if isVerified()
          && isValidId(userId)
          && isValidId(taskId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isVerified()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(taskId)
          && request.auth.uid == userId
          && isValidTaskItem(incoming())
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(taskId)
          && isValidTaskItem(incoming())
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          // Terminal State Locking: only 'pending' tasks can be updated
          && existing().status == 'pending'
          && (
            // Action 1: Complete or Penalize Task
            (incoming().status in ['completed', 'penalized']
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Action 2: Edit pending task details
            (incoming().status == 'pending'
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'difficulty', 'minDurationSeconds', 'xpReward', 'goldReward', 'updatedAt']))
          )
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(taskId)
          && request.auth.uid == userId
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }

    // 6. Global Unique Usernames Registry (/usernames/{username})
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(username)
        && incoming().uid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(username)
        && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn()
        && existing().uid == request.auth.uid;
    }
  }
}
